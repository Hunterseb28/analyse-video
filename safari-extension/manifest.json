{
  "manifest_version": 3,
  "name": "Analyse Video - Audio Overlay",
  "version": "0.1.0",
  "description": "Affiche un analyseur audio synchronisé directement sur la page vidéo.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Analyser la vidéo"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
